# =================================================================
# ABSA Fitness Pipeline - Environment Variables Template
# =================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# Google Maps API Configuration
# Get your API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Gemini API Configuration  
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Project Configuration
PROJECT_ID=your-gcp-project-id
BUCKET_NAME=your-bucket-name
BQ_DATASET=your-dataset-name
BQ_TABLE_RAW=your-table-name

# Service URLs (update after deploying Cloud Functions)
# Format: https://REGION-PROJECT_ID.cloudfunctions.net/FUNCTION_NAME
HANDLER_URL=https://your-region-your-project.cloudfunctions.net/absa-gemini-enricher

# Processing Configuration
MAX_WORKERS=2
